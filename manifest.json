{
  "manifest_version": 3,
  "name": "بیل بیلک - ذره‌بین هوشمند",
  "short_name": "BilBilak",
  "version": "2.0.0",
  "description": "ابزاری کاربردی برای زوم کردن صفحات وب",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "بیل بیلک - تنظیمات"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "magnifier.js", "minimap.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-zoom": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z"
      },
      "description": "فعال/غیرفعال کردن زوم"
    }
  }
}